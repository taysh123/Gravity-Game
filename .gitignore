node_modules/
dist/
.DS_Store
*.local

# Editor / IDE local settings (machine-specific, not part of the project).
.vscode/

# Full-resolution logo originals — source for `npm run optimize:assets`.
# Only the optimized assets/images/*.png are committed.
assets/raw/

# Ad-hoc dev screenshotting + verification (not part of the build).
.shots/
scripts/*.py
scripts/*.png
scripts/__pycache__/

# Raw media-capture dump (regenerable via scripts/capture_media.py).
# Only the curated finals under docs/media/{store,github,portfolio,linkedin} are committed.
docs/media/raw/

.vercel

# Capacitor / Android (generated locally by `npx cap add android`). Build outputs
# and secrets are never committed; the native project itself may be committed.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/google-services.json
android/app/release/
*.keystore
*.jks
