<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backup (D-11/D-12): Auto Backup and device transfer include two locations only, the Preferences mirror
         (CapacitorStorage.xml) and the WebView's Local Storage directory. Third-party SDK SharedPreferences (ad,
         RevenueCat and Firebase ids) are excluded. The Local Storage directory holds localStorage for every origin
         shown in the app's WebViews (e.g. AdMob creatives), and Android cannot filter it per origin.
         dataExtractionRules is read on Android 12+ (API 31+), fullBackupContent on Android 7-11 (API 24-30). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob App ID — REQUIRED by the Mobile Ads SDK's startup provider
             (MobileAdsInitProvider). Without it the app crashes on launch with
             "Missing application ID". This is Google's official TEST app id (no
             AdMob account needed; serves test ads). Replace with your real AdMob
             app id before production, and update src/config/monetization.config.ts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- Consent-first Firebase (D-10, P00-T18). Firebase starts with every Consent Mode default DENIED, with automatic screen
             reporting off and with Crashlytics collection off, so nothing is stored, linked or sent before the app has the UMP
             outcome. src/services/bootServices.ts then writes the four consent types (Analytics.applyConsent) and turns
             Crashlytics collection on (Crash.enable, whatever the outcome: D-10.5, pending the legal check in docs/STATUS.md).
             src/config/manifestConsent.test.ts pins all six values; the merged manifest is checked by V10. -->
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the WebView honour navigator.vibrate (Chromium ignores it without VIBRATE). Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
