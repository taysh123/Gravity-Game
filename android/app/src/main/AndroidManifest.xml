<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Backup (D-11/D-12): Auto Backup and device transfer include two locations only, the Preferences mirror
         (CapacitorStorage.xml) and the WebView's Local Storage directory. Third-party SDK SharedPreferences (ad,
         RevenueCat and Firebase ids) are excluded. The Local Storage directory holds localStorage for every origin
         shown in the app's WebViews (e.g. AdMob creatives), and Android cannot filter it per origin.
         dataExtractionRules is read on Android 12+ (API 31+), fullBackupContent on Android 7-11 (API 24-30). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- AdMob App ID — REQUIRED by the Mobile Ads SDK's startup provider
             (MobileAdsInitProvider). Without it the app crashes on launch with
             "Missing application ID". The value is the manifest placeholder
             admobAppId, set per build type in app/build.gradle (P00-T20): Google's
             TEST app id for debug builds (no AdMob account needed; serves test ads),
             and the real id given as -PADMOB_APP_ID for release. A release build
             fails with a clear message when it is missing or a Google test id.
             See docs/release/RUNBOOK.md section 6. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Consent-first Firebase (D-10, P00-T18). These are the defaults of a FRESH install: Firebase starts with every Consent
             Mode default DENIED, with automatic screen reporting off and with Crashlytics collection off, so on the first launch
             nothing is stored, linked or sent before the app has the UMP outcome. They are NOT a guarantee on later launches: the
             Firebase setConsent values and the Crashlytics setEnabled value are persisted by the SDKs and take precedence over these
             defaults, so from the second launch the last explicit choice applies at process start until UMP answers again.
             src/services/bootServices.ts writes the four consent types (Analytics.applyConsent) and sets Crashlytics collection
             (Crash.enable in every outcome: D-10.5, pending the legal check in docs/STATUS.md; Crash.disable instead when
             CRASH_REQUIRES_ANALYTICS_CONSENT is on). src/config/manifestConsent.test.ts pins all six values; the merged manifest is
             checked by V10.
             Deliberately not added: com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT. It is a Mobile Ads SDK 18.1.0 (2019) flag
             that SDK 24.x no longer reads (the string is absent from the 24.9.0 artifacts, and Google's Mobile Ads SDK forum advisor
             confirmed on 2025-04-10 that it is not supported), so it would only look like a guard. -->
        <meta-data android:name="google_analytics_default_allow_analytics_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_storage" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_user_data" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="google_analytics_automatic_screen_reporting_enabled" android:value="false" />
        <meta-data android:name="firebase_crashlytics_collection_enabled" android:value="false" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the WebView honour navigator.vibrate (Chromium ignores it without VIBRATE). Normal permission: no prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
