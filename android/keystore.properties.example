# Release signing for the Play Store AAB.
#
# 1. Copy this file to  android/keystore.properties  (that real file is gitignored — NEVER commit it).
# 2. Generate an upload keystore (you choose the passwords; keep the .jks safe — if you lose it
#    you can never update the app on Play). From the android/ folder run:
#
#      keytool -genkeypair -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#              -validity 10000 -alias upload
#
#    (Windows PowerShell: use a backtick ` for line-continuation, or put it all on one line.)
#
# 3. Fill in the four values below to match the keystore you just created.
#
# storeFile is resolved relative to android/app/ — e.g. ../upload-keystore.jks points at
# android/upload-keystore.jks. An absolute path also works.

storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
