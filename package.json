    "@revenuecat/purchases-capacitor": "13.7.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "sharp": "^0.34.5",
    "typescript": "^5.4.5",
