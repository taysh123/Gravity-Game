   "after a tier>=2 chunk, pool restricted to tier<=1",
   "exclude last 4 ids (fallback: exclude previous id, then anything)",
   "prefer a different tag than previous (fallback if none)",
   "pick = pool[floor(rng*len)] with mulberry32(fnv1a(seed))",
   "weekly seed = weekKey(date) = gw<floor(daysSinceEpoch/7)>; endless seed = random e<int> per attempt",
   "EndlessScene wraps run[runIndex % 400]"
  ]
 },
